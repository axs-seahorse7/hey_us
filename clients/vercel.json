
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "clients": {
      "root": "clients",
      "framework": "vite"
    },
    "server": {
      "root": "server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "clients"
      }
    }
  ]
}
